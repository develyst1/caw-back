# Copy to .env (git-ignored) and fill in. Every value here is empty on purpose: this file is committed, so no real value ever goes in it.

# Postgres URL of the shared database (CAW uses its own schema "caw" only); pglite:memory for a local run. Required.
DATABASE_URL=
# HTTP port of caw-back; empty means 4500.
PORT=
# Base URL of blueprint-back; empty means http://127.0.0.1:4200.
BLUEPRINT_URL=
# How often caw-back pulls Blueprint's changes, in milliseconds; empty means 30000, and 0 means no timer.
CAW_POLL_MS=
# Folder on this machine under which the runner works on project code (SPEC-C-003). Required by the runner.
CAW_WORKSPACE_ROOT=
# Where Blueprint's web app is, for the link on an amendment; empty means http://127.0.0.1:3100.
BLUEPRINT_WEB_URL=
# Base URL of caw-back for the runner and the MCP server; empty means http://127.0.0.1:4500.
CAW_API_URL=
# How often the runner looks for work, in milliseconds; empty means 2000.
RUNNER_POLL_MS=
# Longest time one hop may run before the runner stops it, in milliseconds; empty means 20 minutes.
RUNNER_HOP_MAX_MS=
# The Claude Code program the runner starts; empty means the runner's own default.
CLAUDE_BIN=
